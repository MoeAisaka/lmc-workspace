      "toSide": "left"
    },
    {
      "id": "agent-link",
      "from": "agent",
      "to": "centre",
      "label": "outbound Socket.IO; centre calls RPC back over it",
      "variant": "emphasis",
      "fromSide": "top",
      "toSide": "bottom"
    },
    {
      "id": "agent-engines",
      "from": "agent",
      "to": "engines",
      "label": "spawns"
