  "cards": [
    {
      "dot": "emerald",
      "title": "Centre",
      "items": [
        "Fastify + Socket.IO on one Docker Compose stack",
        "MySQL 8.4 through Prisma",
        "Redis only to fan out across processes"
      ]
    },
    {
      "dot": "violet",
      "title": "Devices",
      "items": [
        "Agents dial out, so no machine needs an inbound port",
        "The centre reaches back over that same socket to start a session"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust boundary",
      "items": [
        "Records reach the centre already encrypted",
        "The operator holds the key that wraps account keys — self-hosting moves that trust to you, it does not remove it"
      ]
    }
  ]
